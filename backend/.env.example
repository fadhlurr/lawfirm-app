# WAJIB DIISI. Menyalin berkas ini ke .env saja tidak cukup — nilai di bawah
# adalah placeholder, dan `npm run seed` akan berhenti dengan pesan yang
# menjelaskan itu kalau belum diganti.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Supabase: pakai transaction pooler, bukan direct connection — direct
# connection hanya bisa dilewati IPv6 di plan Free.
LAWFIRM_DATABASE_URL="postgresql://postgres:GANTI_PASSWORD@localhost:5432/lawfirm_db"

# Fallback untuk LAWFIRM_DATABASE_URL. Dibaca hanya kalau yang di atas kosong.
DATABASE_URL=

PORT=4000

# Origin yang boleh memanggil API ini, dipisah koma.
CORS_ORIGIN="http://localhost:5173"

# WAJIB DIISI. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Notifikasi email untuk permintaan konsultasi masuk (opsional — tanpa ini,
# permintaan tetap tersimpan, hanya notifikasinya dilewati).
# API key Resend cukup diberi permission Sending access, bukan Full access.
RESEND_API_KEY=
NOTIFY_EMAIL=
